NODE_ENV=dev
PORT=3000
# Number of reverse-proxy hops in front of the app (e.g. 1 behind AWS ALB/Nginx). 0 = none.
TRUST_PROXY=0

DB_URL_LOCAL=<your-value-here>
SALT_ROUNDS=10

# Gmail account used to send confirmation emails (use an App Password)
USER_EMAIL=<your-value-here>
USER_PASSWORD=<your-value-here>

# Any long random string (a 32-byte key is derived from it)
ENCRYPTION_SECRET_KEY=<your-value-here>

JWT_ACCESS_SECRET=<your-value-here>
JWT_ACCESS_EXPIRES_IN=1h
JWT_PREFIX=Bearer
JWT_REFRESH_SECRET=<your-value-here>
JWT_REFRESH_EXPIRES_IN=30d

# Security (all optional - these are the defaults)
MAX_LOGIN_ATTEMPTS=5        # wrong passwords before the account is locked
LOCK_TIME_MINUTES=15        # how long the lock lasts
MAX_OTP_ATTEMPTS=5          # wrong guesses before an OTP is burned
# AUTH_RATE_LIMIT_MAX=100   # per-IP limit on auth routes (default: 100 in dev, 10 otherwise)

WHITE_LISTED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

WEB_CLIENT_ID=<your-value-here>

# Cloudinary (only needed for /profile-picture/cloudinary)
CLOUDINARY_CLOUD_NAME=<your-value-here>
CLOUDINARY_API_KEY=<your-value-here>
CLOUDINARY_API_SECRET=<your-value-here>
