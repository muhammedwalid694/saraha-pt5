        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Pass@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 200 && res.accessToken) {",
                  "    pm.globals.set(\"accessToken\", res.accessToken);",
                  "    pm.globals.set(\"refreshToken\", res.refreshToken);",
                  "    pm.globals.set(\"userId\", res.user._id);",
                  "    console.log(\"Saved global variables: accessToken, refreshToken, userId\");",
                  "} else if (res.twoStepRequired) {",
                  "    console.log(\"2-step required: copy the code from the email into the {{otp}} global, then run 'Login - Verify 2-Step'\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password (max attempts test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "description": "Send this 5 times in a row: the 5th response is 429 (account locked for 15 minutes).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wrong@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Login - Verify 2-Step",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/login/verify-2step",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login",
                "verify-2step"
              ]
            },
            "description": "Only when two-step verification is enabled. Put the emailed code in the {{otp}} global.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 200 && res.accessToken) {",
                  "    pm.globals.set(\"accessToken\", res.accessToken);",
                  "    pm.globals.set(\"refreshToken\", res.refreshToken);",
                  "    pm.globals.set(\"userId\", res.user._id);",
                  "    console.log(\"Saved global variables: accessToken, refreshToken, userId\");",
                  "} else if (res.twoStepRequired) {",
                  "    console.log(\"2-step required: copy the code from the email into the {{otp}} global, then run 'Login - Verify 2-Step'\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Signup / Login with Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/signup-gmail",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "signup-gmail"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "    pm.globals.set(\"accessToken\", res.accessToken);",
                  "    pm.globals.set(\"refreshToken\", res.refreshToken);",
                  "    pm.globals.set(\"userId\", res.user._id);",
                  "    console.log(\"Saved global variables: accessToken, refreshToken, userId\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "refreshtoken",
                "value": "{{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "refresh-token"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.globals.set(\"accessToken\", pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "refreshtoken",
                "value": "{{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/Logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "Logout"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.globals.unset(\"accessToken\");",
                  "    pm.globals.unset(\"refreshToken\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
